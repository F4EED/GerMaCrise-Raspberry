# Copier vers .env avant l'installation :
#   cp .env.example .env
# L'install.sh remplit PI_HOST tout seul si tu le laisses vide.

# IP LAN du Raspberry Pi (téléphones / PC crise). Vide = auto-détection.
PI_HOST=

# Répertoire des dépôts F4EED clonés (relatif à la racine du projet).
APPS_DIR=./apps

# --- EMQX 5.3.2 (seul broker MQTT — ne pas mettre Mosquitto) ---
EMQX_IMAGE=emqx:5.3.2
EMQX_DASHBOARD_USER=admin
# 8 caractères minimum. Change-le avant la première mise en service.
EMQX_DASHBOARD_PASSWORD=ChangeMoiEMQX53
MQTT_USER=meshtastic
MQTT_PASSWORD=ChangeMoiMQTT
MQTT_ROOT_TOPIC=msh/EU_868

# --- Ports (ne pas recoller MeshQTT sur 8080 ni cartoff sur 8000) ---
PORTAIL_PORT=80
PORTAINER_PORT=9443
PORTAINER_IMAGE=portainer/portainer-ce:2.27.4
EMQX_MQTT_PORT=1883
EMQX_DASHBOARD_PORT=18083
GERMACRISE_UI_PORT=3000
GERMACRISE_API_PORT=8000
GERMACRISE_VISU_PORT=3080
GERMACRISE_CARTO_PORT=3081
GERMACRISE_DB_PORT=5433
CARTOFF_PORT=8001
MESHQTT_PORT=8088
PMTILES_PORT=8002
BIPPER_PORT=5173

# --- GerMaCrise / PostGIS ---
POSTGRES_USER=maincourante
POSTGRES_PASSWORD=ChangeMoiPostGIS
POSTGRES_DB=main_courante
SECRET_KEY=ChangeMoiSecretKeyGerMaCrise32charsMin

# Mémoire PostGIS sur Pi 4 (le compose amont peut demander 4 Go : trop).
POSTGIS_MEMORY_LIMIT=768m
